# Select a supported provider: bailian, local-ollama, or mock.
LLM_PROVIDER=bailian

# Select a model enabled for your account.
LLM_MODEL=qwen3.8-max-0902

# Keep real credentials in the ignored .env file.
LLM_API_KEY=replace-with-your-api-key
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_API_PROTOCOL=openai-compatible          ## openai-compatible or anthropic-compatible

# For local Ollama, use:
# LLM_PROVIDER=local-ollama
# LLM_MODEL=your-installed-model
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
