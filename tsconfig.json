{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmitOnError": true,
    "types": ["node"]
  },
  "include": ["cmd/**/*.ts", "internal/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
